# Production environment variables template
# Copy this file to .env.prod.local on the server and fill in the secrets.
# NEVER commit .env.prod.local to version control.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://example.com
###< symfony/routing ###

###> deployment ###
# Domain used by Caddy for automatic HTTPS
DOMAIN=example.com
###< deployment ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://symfony:CHANGE_ME_PASSWORD@db:3306/symfony?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://user:password@smtp.example.com:587
###< symfony/mailer ###
